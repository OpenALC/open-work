# OpenWork 环境变量示例
#
# 复制为 .env 后按需修改。.env 已被 .gitignore 排除，请勿提交真实凭据。

# ─── 运行环境 ───────────────────────────────────────────────────
OPENWORK_ENV=development          # development | staging | production
OPENWORK_LOG_LEVEL=debug          # debug | info | warn | error
OPENWORK_LOG_FORMAT=text          # text | json（生产环境必须为 json）

# ─── HTTP 服务 ──────────────────────────────────────────────────
OPENWORK_HTTP_ADDR=:8080
OPENWORK_HTTP_READ_TIMEOUT=15s
OPENWORK_HTTP_WRITE_TIMEOUT=30s
OPENWORK_HTTP_SHUTDOWN_TIMEOUT=20s
OPENWORK_CORS_ALLOWED_ORIGINS=http://localhost:5173

# ─── 数据库（MySQL 8.4 LTS） ────────────────────────────────────
OPENWORK_DB_DSN=root:root@tcp(127.0.0.1:3306)/openwork?parseTime=true&loc=UTC&multiStatements=true
OPENWORK_DB_MAX_OPEN_CONNS=50
OPENWORK_DB_MAX_IDLE_CONNS=10
OPENWORK_DB_CONN_MAX_LIFETIME=30m
OPENWORK_DB_STATEMENT_TIMEOUT=10s

# ─── Redis ──────────────────────────────────────────────────────
OPENWORK_REDIS_ADDR=127.0.0.1:6379
OPENWORK_REDIS_PASSWORD=
OPENWORK_REDIS_DB=0
OPENWORK_REDIS_POOL_SIZE=20

# ─── 认证 ───────────────────────────────────────────────────────
# 生产环境必须通过密钥管理注入，禁止明文写入仓库
OPENWORK_AUTH_JWT_SECRET=change-me-in-production-min-32-chars
OPENWORK_AUTH_ACCESS_TOKEN_TTL=30m
OPENWORK_AUTH_REFRESH_TOKEN_TTL=720h
OPENWORK_AUTH_ISSUER=openwork

# ─── 实时网关 ───────────────────────────────────────────────────
OPENWORK_REALTIME_ADDR=:8090
OPENWORK_REALTIME_WS_PATH=/ws
OPENWORK_REALTIME_HEARTBEAT=30s
OPENWORK_REALTIME_READ_LIMIT=65536

# ─── Worker ─────────────────────────────────────────────────────
OPENWORK_WORKER_CONCURRENCY=16
OPENWORK_WORKER_OUTBOX_BATCH=100
OPENWORK_WORKER_OUTBOX_INTERVAL=1s
OPENWORK_WORKER_MAX_RETRIES=10

# ─── 文件存储：local | s3 ───────────────────────────────────────
OPENWORK_STORAGE_DRIVER=local
OPENWORK_STORAGE_LOCAL_ROOT=./data/files
# OPENWORK_STORAGE_S3_ENDPOINT=http://127.0.0.1:9000
# OPENWORK_STORAGE_S3_BUCKET=openwork
# OPENWORK_STORAGE_S3_REGION=us-east-1
# OPENWORK_STORAGE_S3_ACCESS_KEY=
# OPENWORK_STORAGE_S3_SECRET_KEY=
# OPENWORK_STORAGE_S3_USE_PATH_STYLE=true

# ─── 可观测性 ───────────────────────────────────────────────────
OPENWORK_OTEL_ENABLED=false
OPENWORK_OTEL_ENDPOINT=http://127.0.0.1:4317
OPENWORK_OTEL_SAMPLE_RATIO=0.1

# ─── 安全 ───────────────────────────────────────────────────────
OPENWORK_RATE_LIMIT_PER_MINUTE=600
OPENWORK_IDEMPOTENCY_TTL=24h
OPENWORK_AUDIT_RETENTION_DAYS=365

# ─── 前端开发 ───────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8080
VITE_WS_BASE_URL=ws://localhost:8090
