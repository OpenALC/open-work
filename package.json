{
  "name": "openwork",
  "version": "0.0.0",
  "private": true,
  "description": "OpenWork — 轻量、开源、可扩展的企业协作与管理平台",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "scripts": {
    "commitlint": "npx --yes @commitlint/cli@19 --config commitlint.config.mjs",
    "lint": "pnpm -r --if-present run lint",
    "typecheck": "pnpm -r --if-present run typecheck",
    "build": "pnpm -r --if-present run build",
    "test": "pnpm -r --if-present run test",
    "e2e": "pnpm -r --if-present run e2e"
  }
}
