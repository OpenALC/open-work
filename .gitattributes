# 统一换行符为 LF，避免 Windows/macOS/Linux 协作产生无意义 diff
* text=auto eol=lf

# 二进制文件
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.zip binary
*.gz binary
*.jar binary

# 生成文件：在 diff 中折叠，合并冲突时以生成结果为准
database/generated/** linguist-generated=true
packages/contracts/generated/** linguist-generated=true
**/*.pb.go linguist-generated=true

# 文档不计入语言统计
docs/** linguist-documentation=true
*.md linguist-documentation=true

# 锁文件
pnpm-lock.yaml linguist-generated=true
go.sum linguist-generated=true
